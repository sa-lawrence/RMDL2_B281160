#set up packages
library(tidyverse)
library(brms)
library(tidybayes)
library(ggdist)
library(posterior)
library(bayesplot)
#| label: read-data
# Example code: delete
files_to_read = list.files(
path = "./Data/",
pattern = "*.csv$",
recursive = TRUE,
full.names = TRUE
)
data_lst <- lapply(files_to_read, function(x) {
read_csv(x, skip = 3) %>%
mutate(
participant_ID = response[1]
)
})
full_RMDLSTROOP <- bind_rows(data_lst)
#filtering the data to remove filler conditions
Stroop_filter <- full_RMDLSTROOP |>
filter(condition1 %in% c("congruent", "incongruent"))
View(Stroop_filter)
View(Stroop_filter)
Stroop_filter <- Stroop_filter %>%
rename(condition1 = Trialtype, condition2 = language)
Stroop_filter <- Stroop_filter %>%
rename(Trialtype = condition1, language = condition2)
Stroop_filter <- Stroop_filter %>%
select(rowNo, type, stim1, textColor, Trialtype, language, key, response, RT, correct, participant_ID)
View(Stroop_filter)
#running the regression model
hindistroopbrm <- brm(
RT ~ language * Trialtype * correct + (language * Trialtype * correct | participant_ID),
family = lognormal,
data = Stroop_filter,
cores = 4,
seed = 6789,
file = "data/cache/hindistroopbrm"
)
#Plotting the raw data
Stroop_filter |>
ggplot(aes(language, RT, fill = language)) +
geom_jitter(alpha = 0.2, width = 0.1)
geom_violin(width = 0.9) +
scale_fill_brewer(palette = "Dark2")+
xlab("Trial Language")+
ylab("Response Reaction Time(ms)")
#Plotting the raw data
Stroop_filter |>
ggplot(aes(language, RT, fill = language)) +
geom_jitter(alpha = 0.2, width = 0.1) +
geom_violin(width = 0.9) +
scale_fill_brewer(palette = "Dark2") +
xlab("Trial Language") +
ylab("Response Reaction Time(ms)")
#Plotting the raw data
Stroop_filter |>
ggplot(aes(Trialtype, RT, fill = language)) +
geom_jitter(alpha = 0.2, width = 0.1) +
geom_violin(width = 0.9) +
scale_fill_brewer(palette = "Dark2") +
xlab("Trial Language") +
ylab("Response Reaction Time(ms)")
#Plotting the raw data
Stroop_filter |>
ggplot(aes(Trialtype, RT, fill = language)) +
geom_jitter(alpha = 0.2, width = 0.1) +
geom_violin(width = 0.7) +
scale_fill_brewer(palette = "Dark2") +
xlab("Trial Condition") +
ylab("Response Reaction Time(ms)")
#Plotting the raw data. This is a jitter plot of RTs separated by trial type and script.
Stroop_filter |>
ggplot(aes(language, RT, fill = language)) +
geom_jitter(alpha = 0.2, width = 0.1) +
geom_violin(width = 0.7) +
scale_fill_brewer(palette = "Dark2") +
facet_grid(cols = vars(Trialtype)) +
xlab("Trial language") +
ylab("Response Reaction Time(ms)")
?make_conditions
conditional_effects(hindistroopbrm, "language:Trialtype")
conditional_effects(hindistroopbrm)
